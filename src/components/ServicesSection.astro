---
import { services } from '../data/site';
---

<section id="szolgaltatasok" class="section-shell pt-20">
  <h2 class="section-title">Szolgáltatásaink</h2>
  <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-5">
    {services.map((service) => (
      <article class="service-card flex min-w-0 flex-col items-center">
        <img
          src={service.icon.src}
          alt=""
          aria-hidden="true"
          width={service.icon.width}
          height={service.icon.height}
          class="relative block h-20 w-20 shrink-0 object-contain object-center"
          loading="lazy"
          decoding="async"
        />
        <h3
          class={`relative mt-6 flex min-h-14 w-full max-w-full items-center justify-center text-center font-extrabold uppercase leading-tight tracking-tight [overflow-wrap:anywhere] ${
            service.title.startsWith('Weboldal') ? 'text-base' : 'text-lg 2xl:text-xl'
          }`}
        >
          {service.title}
        </h3>
        <p class="relative mt-3 w-full max-w-full text-center text-sm leading-7 text-[var(--color-muted)]">
          {service.description}
        </p>
      </article>
    ))}
  </div>
</section>
